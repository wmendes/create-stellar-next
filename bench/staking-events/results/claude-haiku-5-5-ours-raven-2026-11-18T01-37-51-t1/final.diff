--- /dev/null
+++ b/contracts/contracts/staking/src/lib.rs
@@ -0,0 +1,107 @@
+#![no_std]
+use soroban_sdk::{
+    contract, contracterror, contractimpl, contracttype, symbol_short, token, Address, Env,
+};
+
+/// Storage keys. `Token` and `Total` live in instance storage; `Staked` is per user.
+#[contracttype]
+#[derive(Clone)]
+pub enum DataKey {
+    Token,
+    Total,
+    Staked(Address),
+}
+
+#[contracterror]
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+#[repr(u32)]
+pub enum Error {
+    InvalidAmount = 1,
+    InsufficientStake = 2,
+}
+
+#[contract]
+pub struct StakingContract;
+
+fn token_address(env: &Env) -> Address {
+    env.storage().instance().get(&DataKey::Token).unwrap()
+}
+
+fn read_staked(env: &Env, user: &Address) -> i128 {
+    env.storage()
+        .persistent()
+        .get(&DataKey::Staked(user.clone()))
+        .unwrap_or(0)
+}
+
+fn write_staked(env: &Env, user: &Address, amount: i128) {
+    let key = DataKey::Staked(user.clone());
+    env.storage().persistent().set(&key, &amount);
+    env.storage().persistent().extend_ttl(&key, 100_000, 500_000);
+}
+
+#[contractimpl]
+impl StakingContract {
+    /// `token` is the Stellar Asset Contract that is staked: the native XLM SAC for this project.
+    pub fn __constructor(env: Env, token: Address) {
+        env.storage().instance().set(&DataKey::Token, &token);
+        env.storage().instance().set(&DataKey::Total, &0_i128);
+        env.storage().instance().extend_ttl(100_000, 500_000);
+    }
+
+    /// Move `amount` from `user` into the contract and publish `("stake", user) -> amount`.
+    pub fn stake(env: Env, user: Address, amount: i128) -> Result<(), Error> {
+        user.require_auth();
+        if amount <= 0 {
+            return Err(Error::InvalidAmount);
+        }
+        let contract = env.current_contract_address();
+        token::Client::new(&env, &token_address(&env)).transfer(&user, &contract, &amount);
+
+        write_staked(&env, &user, read_staked(&env, &user) + amount);
+        let total: i128 = env.storage().instance().get(&DataKey::Total).unwrap_or(0);
+        env.storage().instance().set(&DataKey::Total, &(total + amount));
+
+        env.events().publish((symbol_short!("stake"), user), amount);
+        Ok(())
+    }
+
+    /// Return `amount` to `user` and publish `("unstake", user) -> amount`.
+    /// Fails with `InsufficientStake` when the user has less than `amount` staked.
+    pub fn unstake(env: Env, user: Address, amount: i128) -> Result<(), Error> {
+        user.require_auth();
+        if amount <= 0 {
+            return Err(Error::InvalidAmount);
+        }
+        let staked = read_staked(&env, &user);
+        if staked < amount {
+            return Err(Error::InsufficientStake);
+        }
+        write_staked(&env, &user, staked - amount);
+        let total: i128 = env.storage().instance().get(&DataKey::Total).unwrap_or(0);
+        env.storage().instance().set(&DataKey::Total, &(total - amount));
+
+        let contract = env.current_contract_address();
+        token::Client::new(&env, &token_address(&env)).transfer(&contract, &user, &amount);
+
+        env.events().publish((symbol_short!("unstake"), user), amount);
+        Ok(())
+    }
+
+    /// The amount `user` has staked.
+    pub fn staked(env: Env, user: Address) -> i128 {
+        read_staked(&env, &user)
+    }
+
+    /// The amount staked by everyone.
+    pub fn total_staked(env: Env) -> i128 {
+        env.storage().instance().get(&DataKey::Total).unwrap_or(0)
+    }
+
+    /// The Stellar Asset Contract this contract stakes.
+    pub fn token(env: Env) -> Address {
+        token_address(&env)
+    }
+}
+
+mod test;
