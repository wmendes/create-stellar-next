diff --git a/app/staking/page.tsx b/app/staking/page.tsx
new file mode 100644
index 0000000..2f467ff
--- /dev/null
+++ b/app/staking/page.tsx
@@ -0,0 +1,110 @@
+import { connection } from "next/server";
+import { Suspense } from "react";
+import { staking } from "@/lib/contracts";
+import { recentStakingEvents, type StakingEvent } from "@/lib/events";
+import { stellar } from "@/lib/stellar";
+
+const EVENT_COUNT = 20;
+
+type Outcome<T> = { ok: true; value: T } | { ok: false; error: string };
+
+function reason(error: unknown): string {
+  return (error instanceof Error && error.message) || String(error) || "unknown error";
+}
+
+// Reads run in try blocks that return plain values. JSX is built after them, never inside them.
+async function attempt<T>(read: () => Promise<T>): Promise<Outcome<T>> {
+  try {
+    return { ok: true, value: await read() };
+  } catch (error) {
+    return { ok: false, error: reason(error) };
+  }
+}
+
+async function TotalStaked() {
+  await connection();
+  const total = await attempt(async () => (await staking().total_staked()).result);
+  if (!total.ok) return <p data-testid="total-error">Could not read the total: {total.error}</p>;
+  return (
+    <p>
+      Total staked: <span data-testid="total-staked">{total.value.toString()}</span>
+    </p>
+  );
+}
+
+async function StakedBy({ address }: { address: string }) {
+  await connection();
+  const staked = await attempt(async () => (await staking().staked({ user: address })).result);
+  if (!staked.ok) {
+    return (
+      <p data-testid="staked-error">
+        Could not read the stake for {address}: {staked.error}
+      </p>
+    );
+  }
+  return (
+    <p>
+      Staked by <code>{address}</code>:{" "}
+      <span data-testid="staked-amount">{staked.value.toString()}</span>
+    </p>
+  );
+}
+
+async function Events() {
+  await connection();
+  const events = await attempt<StakingEvent[]>(() => recentStakingEvents(EVENT_COUNT));
+  if (!events.ok) return <p data-testid="events-error">Could not read events: {events.error}</p>;
+  if (events.value.length === 0) return <p>No stake or unstake events yet.</p>;
+  return (
+    <ol>
+      {events.value.map((event) => (
+        <li
+          key={event.id}
+          data-testid="event"
+          data-type={event.type}
+          data-address={event.address}
+          data-amount={event.amount.toString()}
+        >
+          {event.type} {event.amount.toString()} by <code>{event.address}</code> (ledger{" "}
+          {event.ledger})
+        </li>
+      ))}
+    </ol>
+  );
+}
+
+async function AddressStake({
+  searchParams,
+}: {
+  searchParams: Promise<{ address?: string | string[] }>;
+}) {
+  const { address } = await searchParams;
+  const first = Array.isArray(address) ? address[0] : address;
+  if (!first) return null;
+  return <StakedBy address={first} />;
+}
+
+export default function StakingPage({
+  searchParams,
+}: {
+  searchParams: Promise<{ address?: string | string[] }>;
+}) {
+  return (
+    <main>
+      <h1>Staking</h1>
+      <p>
+        Network: <code>{stellar.network}</code>
+      </p>
+      <Suspense fallback={<p>Reading the total…</p>}>
+        <TotalStaked />
+      </Suspense>
+      <Suspense fallback={<p>Reading the stake…</p>}>
+        <AddressStake searchParams={searchParams} />
+      </Suspense>
+      <h2>Recent activity</h2>
+      <Suspense fallback={<p>Reading events…</p>}>
+        <Events />
+      </Suspense>
+    </main>
+  );
+}
