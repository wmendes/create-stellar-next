@@ -0,0 +1,156 @@
+#![cfg(test)]
+
+use super::*;
+use soroban_sdk::{
+    testutils::{Address as _, Events},
+    token::{StellarAssetClient, TokenClient},
+    Address, Env, IntoVal,
+};
+
+struct Setup<'a> {
+    env: Env,
+    staking: StakingContractClient<'a>,
+    token: TokenClient<'a>,
+    contract_id: Address,
+}
+
+fn setup<'a>() -> Setup<'a> {
+    let env = Env::default();
+    env.mock_all_auths();
+    let admin = Address::generate(&env);
+    let sac = env.register_stellar_asset_contract_v2(admin);
+    let contract_id = env.register(StakingContract, (sac.address(),));
+    let staking = StakingContractClient::new(&env, &contract_id);
+    let token = TokenClient::new(&env, &sac.address());
+    Setup { env, staking, token, contract_id }
+}
+
+fn fund(s: &Setup, user: &Address, amount: i128) {
+    let admin = StellarAssetClient::new(&s.env, &s.token.address);
+    admin.mint(user, &amount);
+}
+
+#[test]
+fn stake_moves_tokens_and_updates_totals() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    let bob = Address::generate(&s.env);
+    fund(&s, &alice, 1_000);
+    fund(&s, &bob, 500);
+
+    assert_eq!(s.staking.staked(&alice), 0);
+    assert_eq!(s.staking.total_staked(), 0);
+
+    s.staking.stake(&alice, &1_000);
+    s.staking.stake(&bob, &200);
+
+    assert_eq!(s.staking.staked(&alice), 1_000);
+    assert_eq!(s.staking.staked(&bob), 200);
+    assert_eq!(s.staking.total_staked(), 1_200);
+    assert_eq!(s.token.balance(&alice), 0);
+    assert_eq!(s.token.balance(&s.contract_id), 1_200);
+}
+
+#[test]
+fn unstake_returns_tokens_and_updates_totals() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 1_000);
+    s.staking.stake(&alice, &1_000);
+
+    s.staking.unstake(&alice, &400);
+
+    assert_eq!(s.staking.staked(&alice), 600);
+    assert_eq!(s.staking.total_staked(), 600);
+    assert_eq!(s.token.balance(&alice), 400);
+    assert_eq!(s.token.balance(&s.contract_id), 600);
+}
+
+#[test]
+fn unstake_more_than_staked_fails() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 100);
+    s.staking.stake(&alice, &100);
+
+    let result = s.staking.try_unstake(&alice, &101);
+    assert_eq!(result, Err(Ok(Error::InsufficientStake)));
+
+    let nothing_staked = Address::generate(&s.env);
+    let result = s.staking.try_unstake(&nothing_staked, &1);
+    assert_eq!(result, Err(Ok(Error::InsufficientStake)));
+
+    // Nothing changed.
+    assert_eq!(s.staking.staked(&alice), 100);
+    assert_eq!(s.staking.total_staked(), 100);
+    assert_eq!(s.token.balance(&alice), 0);
+}
+
+#[test]
+fn non_positive_amounts_are_rejected() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 100);
+    assert_eq!(s.staking.try_stake(&alice, &0), Err(Ok(Error::InvalidAmount)));
+    s.staking.stake(&alice, &50);
+    assert_eq!(s.staking.try_unstake(&alice, &-1), Err(Ok(Error::InvalidAmount)));
+}
+
+#[test]
+fn stake_publishes_one_event_with_two_topics_and_amount_data() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 1_000);
+
+    s.staking.stake(&alice, &250);
+
+    let events = s.env.events().all().filter_by_contract(&s.contract_id);
+    let expected_topics: soroban_sdk::Vec<soroban_sdk::Val> =
+        (symbol_short!("stake"), alice.clone()).into_val(&s.env);
+    assert_eq!(
+        events,
+        soroban_sdk::vec![
+            &s.env,
+            (
+                s.contract_id.clone(),
+                expected_topics,
+                250_i128.into_val(&s.env),
+            )
+        ]
+    );
+}
+
+#[test]
+fn unstake_publishes_one_event_with_two_topics_and_amount_data() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 1_000);
+    s.staking.stake(&alice, &1_000);
+
+    s.staking.unstake(&alice, &300);
+
+    let events = s.env.events().all().filter_by_contract(&s.contract_id);
+    let expected_topics: soroban_sdk::Vec<soroban_sdk::Val> =
+        (symbol_short!("unstake"), alice.clone()).into_val(&s.env);
+    assert_eq!(
+        events,
+        soroban_sdk::vec![
+            &s.env,
+            (
+                s.contract_id.clone(),
+                expected_topics,
+                300_i128.into_val(&s.env),
+            )
+        ]
+    );
+}
+
+#[test]
+fn failed_unstake_publishes_no_event() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 100);
+    s.staking.stake(&alice, &100);
+    let _ = s.staking.try_unstake(&alice, &500);
+    assert_eq!(s.env.events().all().events().len(), 0);
+}
