@@ -0,0 +1,89 @@
+/**
+ * The staking contract's recent `stake` and `unstake` events, read from the Stellar RPC `getEvents`
+ * method. The RPC keeps a bounded window of ledgers. One request scans only part of a range, so
+ * this follows the RPC's cursor to the latest ledger. It widens the scanned range backwards until it
+ * has enough events, then sorts them newest first.
+ */
+import { rpc, scValToNative } from "@stellar/stellar-sdk";
+import { contractId } from "@/lib/contracts";
+import { stellar } from "@/lib/stellar";
+
+export interface StakingEvent {
+  type: "stake" | "unstake";
+  address: string;
+  amount: bigint;
+  ledger: number;
+  id: string;
+}
+
+const PAGE_SIZE = 200;
+const FIRST_WINDOW = 20_000;
+/** An RPC event ID or cursor is "<TOID>-<index>", and the TOID is the ledger sequence shifted left 32 bits. */
+const TOID_SHIFT = BigInt(4294967296);
+
+function ledgerOf(cursor: string): number {
+  return Number(BigInt(cursor.split("-")[0]) / TOID_SHIFT);
+}
+
+function parse(event: rpc.Api.EventResponse): StakingEvent | undefined {
+  const [topicName, topicUser] = event.topic;
+  if (!topicName || !topicUser) return undefined;
+  const type = scValToNative(topicName);
+  if (type !== "stake" && type !== "unstake") return undefined;
+  return {
+    type,
+    address: String(scValToNative(topicUser)),
+    amount: BigInt(scValToNative(event.value)),
+    ledger: event.ledger,
+    id: event.id,
+  };
+}
+
+/** Every staking event from `startLedger` to the latest ledger, following the RPC's cursor. */
+async function eventsFrom(
+  server: rpc.Server,
+  startLedger: number,
+  filters: rpc.Api.GetEventsRequest["filters"],
+): Promise<StakingEvent[]> {
+  const found: StakingEvent[] = [];
+  let cursor: string | undefined;
+  for (;;) {
+    const page: rpc.Api.GetEventsRequest = cursor
+      ? { filters, cursor, limit: PAGE_SIZE }
+      : { filters, startLedger, limit: PAGE_SIZE };
+    const response = await server.getEvents(page);
+    for (const event of response.events) {
+      const parsed = parse(event);
+      if (parsed) found.push(parsed);
+    }
+    // A page can be empty while the scan still advances, so stop only at the latest ledger.
+    if (ledgerOf(response.cursor) >= response.latestLedger || response.cursor === cursor) {
+      return found;
+    }
+    cursor = response.cursor;
+  }
+}
+
+/** The newest `limit` staking events, newest first. */
+export async function recentStakingEvents(limit: number): Promise<StakingEvent[]> {
+  const server = new rpc.Server(stellar.rpcUrl ?? "", {
+    allowHttp: stellar.network === "local",
+  });
+  const health = await server.getHealth();
+  const filters: rpc.Api.GetEventsRequest["filters"] = [
+    { type: "contract", contractIds: [contractId("staking")] },
+  ];
+
+  let window = FIRST_WINDOW;
+  let events: StakingEvent[] = [];
+  for (;;) {
+    const start = Math.max(health.oldestLedger, health.latestLedger - window);
+    events = await eventsFrom(server, start, filters);
+    if (events.length >= limit || start <= health.oldestLedger) break;
+    window *= 4;
+  }
+
+  // Event IDs are "<ledger TOID>-<index>" with fixed-width parts, so comparing them as strings
+  // orders them by time within the same ledger too.
+  return events.sort((a, b) => (a.id < b.id ? 1 : a.id > b.id ? -1 : 0)).slice(0, limit);
+}
