diff --git a/contracts/staking/src/lib.rs b/contracts/staking/src/lib.rs
new file mode 100644
index 0000000..7a0e9ff
--- /dev/null
+++ b/contracts/staking/src/lib.rs
@@ -0,0 +1,178 @@
+#![no_std]
+
+//! Staking contract for a Stellar token (the native XLM Stellar Asset Contract
+//! in practice). Users deposit tokens with `stake` and withdraw them with
+//! `unstake`. Every successful call publishes one event:
+//!
+//! - topics: `(Symbol("stake" | "unstake"), Address(user))`
+//! - data:   `i128` amount
+
+use soroban_sdk::{
+    Address, Env, contract, contracterror, contractevent, contractimpl, contracttype,
+    panic_with_error, token,
+};
+
+/// Published by a successful `stake`: topics `("stake", user)`, data `amount`.
+#[contractevent(topics = ["stake"], data_format = "single-value")]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Stake {
+    #[topic]
+    pub user: Address,
+    pub amount: i128,
+}
+
+/// Published by a successful `unstake`: topics `("unstake", user)`, data `amount`.
+#[contractevent(topics = ["unstake"], data_format = "single-value")]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Unstake {
+    #[topic]
+    pub user: Address,
+    pub amount: i128,
+}
+
+/// Ledger TTL policy for storage entries (about 5 seconds per ledger).
+const DAY_IN_LEDGERS: u32 = 17_280;
+const TTL_THRESHOLD: u32 = 7 * DAY_IN_LEDGERS;
+const TTL_EXTEND_TO: u32 = 30 * DAY_IN_LEDGERS;
+
+#[contracttype]
+#[derive(Clone)]
+enum DataKey {
+    /// Address of the staked token's Stellar Asset Contract (instance storage).
+    Token,
+    /// Total amount staked by everyone (instance storage).
+    TotalStaked,
+    /// Amount staked by one user (persistent storage).
+    Staked(Address),
+}
+
+#[contracterror]
+#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]
+#[repr(u32)]
+pub enum Error {
+    /// Stake and unstake amounts must be strictly positive.
+    InvalidAmount = 1,
+    /// The user is trying to unstake more than they have staked.
+    InsufficientStake = 2,
+}
+
+#[contract]
+pub struct StakingContract;
+
+#[contractimpl]
+impl StakingContract {
+    /// Runs once at deployment. `token` is the Stellar Asset Contract address
+    /// of the asset to stake; for XLM, the native asset's SAC on the network.
+    pub fn __constructor(env: Env, token: Address) {
+        env.storage().instance().set(&DataKey::Token, &token);
+        env.storage().instance().set(&DataKey::TotalStaked, &0_i128);
+        env.storage()
+            .instance()
+            .extend_ttl(TTL_THRESHOLD, TTL_EXTEND_TO);
+    }
+
+    /// Move `amount` of the token from `user` into the contract.
+    pub fn stake(env: Env, user: Address, amount: i128) {
+        user.require_auth();
+        if amount <= 0 {
+            panic_with_error!(&env, Error::InvalidAmount);
+        }
+
+        let token = token_address(&env);
+        token::TokenClient::new(&env, &token).transfer(
+            &user,
+            &env.current_contract_address(),
+            &amount,
+        );
+
+        let key = DataKey::Staked(user.clone());
+        let staked: i128 = env.storage().persistent().get(&key).unwrap_or(0);
+        env.storage().persistent().set(&key, &(staked + amount));
+        env.storage()
+            .persistent()
+            .extend_ttl(&key, TTL_THRESHOLD, TTL_EXTEND_TO);
+        add_total(&env, amount);
+
+        Stake { user, amount }.publish(&env);
+    }
+
+    /// Return `amount` of the token from the contract to `user`.
+    /// Fails if `user` has less than `amount` staked.
+    pub fn unstake(env: Env, user: Address, amount: i128) {
+        user.require_auth();
+        if amount <= 0 {
+            panic_with_error!(&env, Error::InvalidAmount);
+        }
+
+        let key = DataKey::Staked(user.clone());
+        let staked: i128 = env.storage().persistent().get(&key).unwrap_or(0);
+        if staked < amount {
+            panic_with_error!(&env, Error::InsufficientStake);
+        }
+        if staked == amount {
+            env.storage().persistent().remove(&key);
+        } else {
+            env.storage().persistent().set(&key, &(staked - amount));
+            env.storage()
+                .persistent()
+                .extend_ttl(&key, TTL_THRESHOLD, TTL_EXTEND_TO);
+        }
+        add_total(&env, -amount);
+
+        let token = token_address(&env);
+        token::TokenClient::new(&env, &token).transfer(
+            &env.current_contract_address(),
+            &user,
+            &amount,
+        );
+
+        Unstake { user, amount }.publish(&env);
+    }
+
+    /// The amount `user` currently has staked.
+    pub fn staked(env: Env, user: Address) -> i128 {
+        let key = DataKey::Staked(user);
+        match env.storage().persistent().get(&key) {
+            Some(amount) => {
+                env.storage()
+                    .persistent()
+                    .extend_ttl(&key, TTL_THRESHOLD, TTL_EXTEND_TO);
+                amount
+            }
+            None => 0,
+        }
+    }
+
+    /// The amount staked by everyone together.
+    pub fn total_staked(env: Env) -> i128 {
+        env.storage()
+            .instance()
+            .get(&DataKey::TotalStaked)
+            .unwrap_or(0)
+    }
+
+    /// The token contract address this staking contract holds.
+    pub fn token(env: Env) -> Address {
+        token_address(&env)
+    }
+}
+
+fn token_address(env: &Env) -> Address {
+    env.storage()
+        .instance()
+        .get(&DataKey::Token)
+        .expect("staking contract is not initialized")
+}
+
+fn add_total(env: &Env, delta: i128) {
+    let total: i128 = env
+        .storage()
+        .instance()
+        .get(&DataKey::TotalStaked)
+        .unwrap_or(0);
+    env.storage()
+        .instance()
+        .set(&DataKey::TotalStaked, &(total + delta));
+}
+
+mod test;
