index 0000000..3a59373
--- /dev/null
+++ b/app/src/staking/chain.ts
@@ -0,0 +1,124 @@
+// Read-only access to the staking contract on Stellar testnet. This module talks
+// to the testnet RPC directly and does not use the wallet or the generated clients,
+// so the /staking page always shows testnet data.
+import {
+	Account,
+	Address,
+	BASE_FEE,
+	Contract,
+	nativeToScVal,
+	Networks,
+	rpc,
+	scValToNative,
+	StrKey,
+	TransactionBuilder,
+	xdr,
+} from "@stellar/stellar-sdk"
+
+export const TESTNET_RPC_URL = "https://soroban-testnet.stellar.org"
+export const TESTNET_PASSPHRASE = Networks.TESTNET
+export const STAKING_CONTRACT_ID = __STAKING_CONTRACT_ID__
+
+/** Read-only simulations need a source account but never submit, so any valid address works. */
+const SIMULATION_SOURCE = StrKey.encodeEd25519PublicKey(new Uint8Array(32))
+
+/** Covers the RPC's retention window (about 7 days of ledgers). */
+const EVENT_LOOKBACK_LEDGERS = 120_000
+
+export type StakingEventType = "stake" | "unstake"
+
+export interface StakingEvent {
+	id: string
+	ledger: number
+	type: StakingEventType
+	address: string
+	amount: bigint
+}
+
+const server = new rpc.Server(TESTNET_RPC_URL)
+
+/** Whether `value` is a Stellar account or contract address that `Address` accepts. */
+export const isStellarAddress = (value: string): boolean =>
+	StrKey.isValidEd25519PublicKey(value) || StrKey.isValidContract(value)
+
+/** Simulate a read-only call to a contract function and return its native value. */
+async function readContract(method: string, args: xdr.ScVal[] = []) {
+	const contract = new Contract(STAKING_CONTRACT_ID)
+	const tx = new TransactionBuilder(new Account(SIMULATION_SOURCE, "0"), {
+		fee: BASE_FEE,
+		networkPassphrase: TESTNET_PASSPHRASE,
+	})
+		.addOperation(contract.call(method, ...args))
+		.setTimeout(30)
+		.build()
+	const sim = await server.simulateTransaction(tx)
+	if (!rpc.Api.isSimulationSuccess(sim) || !sim.result) {
+		throw new Error(`Could not read ${method} from the contract on testnet`)
+	}
+	return scValToNative(sim.result.retval)
+}
+
+/** Total amount staked by everyone, as returned by `total_staked`. */
+export async function fetchTotalStaked(): Promise<bigint> {
+	return BigInt(await readContract("total_staked"))
+}
+
+/** Amount `address` has staked, as returned by `staked`. */
+export async function fetchStaked(address: string): Promise<bigint> {
+	return BigInt(
+		await readContract("staked", [Address.fromString(address).toScVal()]),
+	)
+}
+
+// Stellar RPC returns events oldest first and scans a limited number of ledgers
+// per request. A cursor resumes where the last request stopped, so follow it until
+// it reaches the latest ledger.
+const ledgerOfCursor = (cursor: string): number =>
+	Number(BigInt(cursor.split("-")[0] ?? "0") >> 32n)
+
+/** The contract's `stake` and `unstake` events, newest first. */
+export async function fetchStakingEvents(): Promise<StakingEvent[]> {
+	const health = await server.getHealth()
+	const topicFilter = (name: StakingEventType): [string, string] => [
+		nativeToScVal(name, { type: "symbol" }).toXDR("base64"),
+		"*",
+	]
+	const filters: rpc.Api.EventFilter[] = [
+		{
+			type: "contract",
+			contractIds: [STAKING_CONTRACT_ID],
+			topics: [topicFilter("stake"), topicFilter("unstake")],
+		},
+	]
+
+	const events: StakingEvent[] = []
+	let request: rpc.Api.GetEventsRequest = {
+		filters,
+		limit: 200,
+		startLedger: Math.max(
+			health.oldestLedger,
+			health.latestLedger - EVENT_LOOKBACK_LEDGERS,
+		),
+	}
+	for (;;) {
+		const page = await server.getEvents(request)
+		for (const event of page.events) {
+			// Each event has exactly two topics: the event name, then the user's address.
+			const [nameTopic, userTopic] = event.topic as [xdr.ScVal, xdr.ScVal]
+			const type = scValToNative(nameTopic)
+			if (type !== "stake" && type !== "unstake") continue
+			events.push({
+				id: event.id,
+				ledger: event.ledger,
+				type,
+				address: String(scValToNative(userTopic)),
+				amount: BigInt(scValToNative(event.value)),
+			})
+		}
+		if (!page.cursor || ledgerOfCursor(page.cursor) >= page.latestLedger) break
+		request = { filters, limit: 200, cursor: page.cursor }
+	}
+
+	// Event IDs are fixed-width, so comparing them as strings orders them by position.
+	return events.sort((a, b) => (a.id < b.id ? 1 : a.id > b.id ? -1 : 0))
+}
