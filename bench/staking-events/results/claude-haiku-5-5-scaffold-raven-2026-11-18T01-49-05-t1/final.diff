+#![cfg(test)]
+extern crate std;
+
+use super::*;
+use soroban_sdk::{
+    Address, Env, IntoVal, Val, Vec as SorobanVec,
+    testutils::{Address as _, Events},
+    testutils::ContractEvents,
+    symbol_short,
+    token::{StellarAssetClient, TokenClient},
+};
+
+const ONE: i128 = 10_000_000; // 1 XLM in stroops
+
+/// The host-level error a `try_*` call returns for one of this contract's errors.
+fn code(e: Error) -> soroban_sdk::Error {
+    soroban_sdk::Error::from_contract_error(e as u32)
+}
+
+struct Setup<'a> {
+    env: Env,
+    token: TokenClient<'a>,
+    sac: StellarAssetClient<'a>,
+    client: StakingContractClient<'a>,
+    contract_id: Address,
+    token_id: Address,
+}
+
+fn setup<'a>() -> Setup<'a> {
+    let env = Env::default();
+    // Deploy-time and setup calls are not what these tests check, so mock auth
+    // while creating the token, minting, and deploying the staking contract.
+    env.mock_all_auths();
+    let admin = Address::generate(&env);
+    let token_id = env.register_stellar_asset_contract_v2(admin.clone()).address();
+    let token = TokenClient::new(&env, &token_id);
+    let sac = StellarAssetClient::new(&env, &token_id);
+    let contract_id = env.register(StakingContract, (&token_id,));
+    let client = StakingContractClient::new(&env, &contract_id);
+    // Each test chooses its own authorizations from here on.
+    env.set_auths(&[]);
+    Setup { env, token, sac, client, contract_id, token_id }
+}
+
+/// Mint `amount` to `user` using mocked auth (the SAC admin is not the user).
+fn fund(s: &Setup, user: &Address, amount: i128) {
+    s.env.mock_all_auths();
+    s.sac.mint(user, &amount);
+    s.env.set_auths(&[]);
+}
+
+fn stake_as(s: &Setup, user: &Address, amount: i128) {
+    s.env.mock_all_auths();
+    s.client.stake(user, &amount);
+    s.env.set_auths(&[]);
+}
+
+fn unstake_as(s: &Setup, user: &Address, amount: i128) {
+    s.env.mock_all_auths();
+    s.client.unstake(user, &amount);
+    s.env.set_auths(&[]);
+}
+
+/// Events emitted by the staking contract itself (not by the token contract).
+fn staking_events(s: &Setup) -> ContractEvents {
+    s.env.events().all().filter_by_contract(&s.contract_id)
+}
+
+#[test]
+fn deploys_ready_to_use_with_token_and_zero_totals() {
+    let s = setup();
+    assert_eq!(s.client.token(), s.token_id);
+    assert_eq!(s.client.total_staked(), 0);
+    let alice = Address::generate(&s.env);
+    assert_eq!(s.client.staked(&alice), 0);
+}
+
+#[test]
+fn stake_moves_tokens_and_updates_balances() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    let bob = Address::generate(&s.env);
+    fund(&s, &alice, 100 * ONE);
+    fund(&s, &bob, 50 * ONE);
+
+    stake_as(&s, &alice, 60 * ONE);
+    stake_as(&s, &alice, 10 * ONE);
+    stake_as(&s, &bob, 5 * ONE);
+
+    assert_eq!(s.client.staked(&alice), 70 * ONE);
+    assert_eq!(s.client.staked(&bob), 5 * ONE);
+    assert_eq!(s.client.total_staked(), 75 * ONE);
+    assert_eq!(s.token.balance(&alice), 30 * ONE);
+    assert_eq!(s.token.balance(&s.contract_id), 75 * ONE);
+}
+
+#[test]
+fn unstake_returns_tokens_and_updates_balances() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 100 * ONE);
+    stake_as(&s, &alice, 40 * ONE);
+
+    unstake_as(&s, &alice, 15 * ONE);
+
+    assert_eq!(s.client.staked(&alice), 25 * ONE);
+    assert_eq!(s.client.total_staked(), 25 * ONE);
+    assert_eq!(s.token.balance(&alice), 75 * ONE);
+    assert_eq!(s.token.balance(&s.contract_id), 25 * ONE);
+
+    // Withdrawing the rest leaves nothing staked.
+    unstake_as(&s, &alice, 25 * ONE);
+    assert_eq!(s.client.staked(&alice), 0);
+    assert_eq!(s.client.total_staked(), 0);
+    assert_eq!(s.token.balance(&alice), 100 * ONE);
+}
+
+#[test]
+fn unstake_more_than_staked_fails_and_changes_nothing() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 10 * ONE);
+    stake_as(&s, &alice, 3 * ONE);
+
+    s.env.mock_all_auths();
+    let result = s.client.try_unstake(&alice, &(3 * ONE + 1));
+    s.env.set_auths(&[]);
+    assert_eq!(result, Err(Ok(code(Error::InsufficientStake))));
+
+    // A user with nothing staked cannot unstake either.
+    let bob = Address::generate(&s.env);
+    s.env.mock_all_auths();
+    let result = s.client.try_unstake(&bob, &1);
+    s.env.set_auths(&[]);
+    assert_eq!(result, Err(Ok(code(Error::InsufficientStake))));
+
+    assert_eq!(s.client.staked(&alice), 3 * ONE);
+    assert_eq!(s.client.total_staked(), 3 * ONE);
+    assert_eq!(s.token.balance(&alice), 7 * ONE);
+}
+
+#[test]
+fn non_positive_amounts_are_rejected() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, ONE);
+    s.env.mock_all_auths();
+    assert_eq!(s.client.try_stake(&alice, &0), Err(Ok(code(Error::InvalidAmount))));
+    assert_eq!(s.client.try_stake(&alice, &-1), Err(Ok(code(Error::InvalidAmount))));
+    assert_eq!(s.client.try_unstake(&alice, &0), Err(Ok(code(Error::InvalidAmount))));
+    s.env.set_auths(&[]);
+    assert_eq!(s.client.total_staked(), 0);
+}
+
+#[test]
+fn stake_and_unstake_require_the_user_to_authorize() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 10 * ONE);
+    // No auth mocks are set: the user's authorization is missing.
+    assert!(s.client.try_stake(&alice, &ONE).is_err());
+    stake_as(&s, &alice, 2 * ONE);
+    assert!(s.client.try_unstake(&alice, &ONE).is_err());
+    assert_eq!(s.client.staked(&alice), 2 * ONE);
+}
+
+#[test]
+fn stake_publishes_one_event_with_two_topics_and_amount_data() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 10 * ONE);
+    stake_as(&s, &alice, 4 * ONE);
+
+    let expected: SorobanVec<(Address, SorobanVec<Val>, Val)> = soroban_sdk::vec![
+        &s.env,
+        (
+            s.contract_id.clone(),
+            (symbol_short!("stake"), alice.clone()).into_val(&s.env),
+            (4 * ONE).into_val(&s.env),
+        ),
+    ];
+    assert_eq!(staking_events(&s), expected);
+}
+
+#[test]
+fn unstake_publishes_one_event_with_two_topics_and_amount_data() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 10 * ONE);
+    stake_as(&s, &alice, 4 * ONE);
+    unstake_as(&s, &alice, ONE);
+
+    let expected: SorobanVec<(Address, SorobanVec<Val>, Val)> = soroban_sdk::vec![
+        &s.env,
+        (
+            s.contract_id.clone(),
+            (symbol_short!("unstake"), alice.clone()).into_val(&s.env),
+            ONE.into_val(&s.env),
+        ),
+    ];
+    assert_eq!(staking_events(&s), expected);
+}
+
+#[test]
+fn failed_calls_publish_no_staking_event() {
+    let s = setup();
+    let alice = Address::generate(&s.env);
+    fund(&s, &alice, 10 * ONE);
+    s.env.mock_all_auths();
+    let _ = s.client.try_unstake(&alice, &ONE);
+    s.env.set_auths(&[]);
+    assert_eq!(staking_events(&s).events().len(), 0);
+}
