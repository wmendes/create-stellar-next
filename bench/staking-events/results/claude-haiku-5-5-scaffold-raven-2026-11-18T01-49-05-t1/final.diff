@@ -0,0 +1,153 @@
+import { useQuery } from "@tanstack/react-query"
+import { type FormEvent, useState } from "react"
+import { useSearchParams } from "react-router-dom"
+import {
+	fetchStaked,
+	fetchStakingEvents,
+	fetchTotalStaked,
+	isStellarAddress,
+	STAKING_CONTRACT_ID,
+} from "../staking/chain"
+import styles from "./Staking.module.css"
+
+/** How many of the newest events the activity feed shows. */
+const FEED_SIZE = 20
+
+export default function Staking() {
+	const [searchParams, setSearchParams] = useSearchParams()
+	const address = searchParams.get("address")?.trim() ?? ""
+	const hasAddress = address !== ""
+	const addressIsValid = hasAddress && isStellarAddress(address)
+
+	const total = useQuery({
+		queryKey: ["staking", "total-staked"],
+		queryFn: fetchTotalStaked,
+	})
+
+	const staked = useQuery({
+		queryKey: ["staking", "staked", address],
+		queryFn: () => fetchStaked(address),
+		enabled: addressIsValid,
+	})
+
+	const events = useQuery({
+		queryKey: ["staking", "events"],
+		queryFn: fetchStakingEvents,
+		refetchInterval: 30_000,
+	})
+
+	return (
+		<section className={styles.page}>
+			<h1>Staking</h1>
+			<p className={styles.lede}>
+				XLM staked in the staking contract on Stellar testnet.
+				<br />
+				<code className={styles.contract}>{STAKING_CONTRACT_ID}</code>
+			</p>
+
+			<div className={styles.card}>
+				<h2>Total staked</h2>
+				{total.data !== undefined ? (
+					<p className={styles.value} data-testid="total-staked">
+						{total.data.toString()}
+					</p>
+				) : total.isError ? (
+					<p className={styles.error}>{String(total.error)}</p>
+				) : (
+					<p className={styles.muted}>Loading…</p>
+				)}
+			</div>
+
+			<div className={styles.card}>
+				<h2>Staked by address</h2>
+				<AddressForm
+					key={address}
+					initial={address}
+					onSubmit={(value) =>
+						setSearchParams(value ? { address: value } : {}, { replace: true })
+					}
+				/>
+				{!hasAddress ? (
+					<p className={styles.muted}>
+						Enter a Stellar address to see its staked amount.
+					</p>
+				) : !addressIsValid ? (
+					<p className={styles.error}>
+						"{address}" is not a valid Stellar address.
+					</p>
+				) : staked.data !== undefined ? (
+					<p className={styles.value} data-testid="staked-amount">
+						{staked.data.toString()}
+					</p>
+				) : staked.isError ? (
+					<p className={styles.error}>{String(staked.error)}</p>
+				) : (
+					<p className={styles.muted}>Loading…</p>
+				)}
+			</div>
+
+			<div className={styles.card}>
+				<h2>Recent activity</h2>
+				{events.data !== undefined ? (
+					events.data.length === 0 ? (
+						<p className={styles.muted}>No stake or unstake events yet.</p>
+					) : (
+						<ol className={styles.feed}>
+							{events.data.slice(0, FEED_SIZE).map((event) => (
+								<li
+									key={event.id}
+									className={styles.event}
+									data-testid="event"
+									data-type={event.type}
+									data-address={event.address}
+									data-amount={event.amount.toString()}
+								>
+									<span className={styles.type} data-kind={event.type}>
+										{event.type}
+									</span>
+									<code className={styles.address}>{event.address}</code>
+									<span className={styles.amount}>
+										{event.amount.toString()}
+									</span>
+									<span className={styles.ledger}>ledger {event.ledger}</span>
+								</li>
+							))}
+						</ol>
+					)
+				) : events.isError ? (
+					<p className={styles.error}>{String(events.error)}</p>
+				) : (
+					<p className={styles.muted}>Loading…</p>
+				)}
+			</div>
+		</section>
+	)
+}
+
+function AddressForm({
+	initial,
+	onSubmit,
+}: {
+	initial: string
+	onSubmit: (value: string) => void
+}) {
+	const [value, setValue] = useState(initial)
+	const handleSubmit = (event: FormEvent) => {
+		event.preventDefault()
+		onSubmit(value.trim())
+	}
+	return (
+		<form className={styles.form} onSubmit={handleSubmit}>
+			<input
+				name="address"
+				type="text"
+				placeholder="G… or C… address"
+				aria-label="Stellar address"
+				value={value}
+				onChange={(event) => setValue(event.target.value)}
+				spellCheck={false}
+			/>
+			<button type="submit">Look up</button>
+		</form>
+	)
+}
