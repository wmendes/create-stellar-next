{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/create-stellar-next/schemas/doctor.schema.json#v1",
  "title": "create-stellar-next doctor --json output",
  "description": "The one JSON object `doctor --json` prints on stdout (SPEC §5.3). errors is empty exactly when the exit code is 0; each failed check also appears in errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checks", "errors"],
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema. Bumped on any change to the output's shape or codes.",
      "const": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "failed", "skipped"] },
          "detail": { "type": "string" },
          "fix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "fix"],
        "properties": {
          "code": { "enum": ["MISSING_PREREQUISITE", "INVALID_ARGUMENT"] },
          "message": { "type": "string", "minLength": 1 },
          "fix": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
