{
  "//": "Typechecks the templates in place against the root devDependencies. Not copied into projects.",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/packages/*": ["./_typecheck/packages/*"],
      "@/*": ["./base/*", "./contracts/*", "./wallet-wallets-kit/*", "./wallet-ui/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["_typecheck"]
}
